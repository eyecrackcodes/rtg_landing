# ── Bold FC lead delivery ────────────────────────────────────
# Copy to .env for local `vercel dev`, and set the same keys in
# Vercel → Project → Settings → Environment Variables for prod.
# Set AT LEAST ONE sink, or leads only land in the Vercel log.

# Sink 1 — any JSON webhook (n8n, Zapier, Make, Airtable, CRM)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_KEY=

# Sink 2 — email notification via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=info@rtgacademy.com
LEAD_FROM_EMAIL=leads@rtgacademy.com
